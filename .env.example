# Copy to .env.local (gitignored) to change the defaults. All optional — the
# Settings page (/settings) overrides the AI and backup settings and is the
# normal way to change them.

# Where the SQLite database lives (default: data/crm.db under the project).
# CRM_DB_PATH=/path/to/crm.db

# Daily backup folder: default data/backups next to the database; "off" disables.
# Point at a synced folder for off-machine copies (the whole CRM, unencrypted).
# CRM_BACKUP_DIR=~/My Drive/Backups/siryous-crm

# Local open-weight model (Ollama). The AI features think and write here.
LOCAL_LLM_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=gemma4:26b
LOCAL_LLM_NUM_CTX=32768
LOCAL_LLM_TEMPERATURE=0.3
# Allow a non-private Ollama host (the prompt contains your whole roster — leave off unless you mean it).
# LOCAL_LLM_ALLOW_REMOTE=1

# Which provider does the tool-less "write" steps: local (default) or claude.
AI_PROVIDER=local
# If Ollama is unavailable: fall back to claude (default) or none.
AI_FALLBACK=claude

# Path to the Claude Code CLI if it isn't on PATH, in ~/.local/bin or /opt/homebrew/bin.
# CLAUDE_BIN=/path/to/claude
